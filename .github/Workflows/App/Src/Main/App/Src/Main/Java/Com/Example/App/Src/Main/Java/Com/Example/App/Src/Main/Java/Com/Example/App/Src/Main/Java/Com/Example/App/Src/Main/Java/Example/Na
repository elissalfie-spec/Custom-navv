package com.example.navapp.ui.components

import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.grid.GridCells
import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
import androidx.compose.foundation.lazy.grid.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import com.example.navapp.models.AvatarPuck
import com.example.navapp.models.MasterAppSettings
import com.example.navapp.models.RestrictionProfile

@Composable
fun AvatarSelectionDialog(
    currentSettings: MasterAppSettings,
    onDismiss: () -> Unit,
    onAvatarSelected: (MasterAppSettings) -> Unit
) {
    var selectedAvatar by remember { mutableStateOf<AvatarPuck?>(null) }
    var dontShowAgain by remember { mutableStateOf(false) }

    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("Select Navigation Avatar", color = Color.White) },
        text = {
            Column {
                LazyVerticalGrid(
                    columns = GridCells.Fixed(3),
                    modifier = Modifier.height(180.dp)
                ) {
                    items(AvatarPuck.values()) { avatar ->
                        Card(
                            modifier = Modifier
                                .padding(4.dp)
                                .clickable {
                                    if (currentSettings.suppressAvatarPrompt) {
                                        onAvatarSelected(currentSettings.copy(avatarPuck = avatar))
                                    } else {
                                        selectedAvatar = avatar
                                    }
                                },
                            colors = CardDefaults.cardColors(containerColor = Color(0xFF2C2C3E))
                        ) {
                            Column(
                                modifier = Modifier
                                    .padding(12.dp)
                                    .fillMaxWidth(),
                                horizontalAlignment = Alignment.CenterHorizontally
                            ) {
                                Text(avatar.emoji, fontSize = 32.sp)
                                Text(avatar.displayName, fontSize = 10.sp, color = Color.White)
                            }
                        }
                    }
                }

                if (selectedAvatar != null) {
                    Spacer(modifier = Modifier.height(12.dp))
                    Text(
                        "Change routing rules to match ${selectedAvatar?.displayName} or keep current?",
                        color = Color.LightGray,
                        fontSize = 12.sp
                    )
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Checkbox(
                            checked = dontShowAgain,
                            onCheckedChange = { dontShowAgain = it }
                        )
                        Text("Don't ask again", color = Color.Gray, fontSize = 12.sp)
                    }
                }
            }
        },
        confirmButton = {
            if (selectedAvatar != null) {
                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    TextButton(onClick = {
                        val updated = currentSettings.copy(
                            avatarPuck = selectedAvatar!!,
                            suppressAvatarPrompt = dontShowAgain
                        )
                        onAvatarSelected(updated)
                    }) {
                        Text("Keep Rules")
                    }
                    Button(onClick = {
                        val matchingProfile = when (selectedAvatar) {
                            AvatarPuck.LORRY -> RestrictionProfile.LORRY_HEAVY
                            AvatarPuck.TRACTOR -> RestrictionProfile.TRACTOR
                            AvatarPuck.MOTORCYCLE -> RestrictionProfile.MOTORCYCLE
                            else -> RestrictionProfile.NONE
                        }
                        val updated = currentSettings.copy(
                            avatarPuck = selectedAvatar!!,
                            vehicleRestrictions = matchingProfile,
                            suppressAvatarPrompt = dontShowAgain
                        )
                        onAvatarSelected(updated)
                    }) {
                        Text("Match Vehicle")
                    }
                }
            }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("Cancel") }
        },
        containerColor = Color(0xFF1E1E2C)
    )
}
