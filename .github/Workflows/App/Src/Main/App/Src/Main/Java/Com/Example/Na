package com.example.navapp.models

import androidx.compose.ui.graphics.Color

enum class AvatarPuck(val displayName: String, val emoji: String) {
    CAR("Car", "🚗"),
    MOTORCYCLE("Motorcycle", "🏍"),
    LORRY("Lorry", "🚚"),
    TRACTOR("Tractor", "🚜"),
    DRAGON("Dragon", "🐉"),
    UNICORN("Unicorn", "🦄")
}

enum class RestrictionProfile(val label: String) {
    NONE("None (Car)"),
    LORRY_HEAVY("Lorry / HGV Restrictions"),
    TRACTOR("Low-Speed / Agricultural"),
    MOTORCYCLE("Motorcycle Rules")
}

enum class OptimizationStyle(val label: String) {
    FASTEST("Fastest Route"),
    SCENIC_CURVY("Scenic & Curvy"),
    AVOID_HIGHWAYS("Avoid Motorways")
}

enum class VoiceVerbosity { VERBOSE, STANDARD, MINIMAL_ALERTS, MUTED }

data class MasterAppSettings(
    val accentColor: Color = Color(0xFFFF3D00),
    val isHudModeEnabled: Boolean = false,
    val mapFontSizeMultiplier: Float = 1.0f,
    val avatarPuck: AvatarPuck = AvatarPuck.TRACTOR,
    val vehicleRestrictions: RestrictionProfile = RestrictionProfile.LORRY_HEAVY,
    val routeOptimization: OptimizationStyle = OptimizationStyle.SCENIC_CURVY,
    val suppressAvatarPrompt: Boolean = false,
    val showLiveTraffic: Boolean = true,
    val showAccidentHotspots: Boolean = true,
    val showWeatherRadar: Boolean = false,
    val showSpeedCameras: Boolean = true,
    val voiceVerbosity: VoiceVerbosity = VoiceVerbosity.STANDARD,
    val audioDuckingEnabled: Boolean = true,
    val avatarSoundPackEnabled: Boolean = true,
    val speedLimitWarningMph: Int = 5,
    val isAiSignGuardEnabled: Boolean = true,
    val showOnLockscreen: Boolean = true,
    val keepScreenAwake: Boolean = true,
    val showMusicWidget: Boolean = true
)
