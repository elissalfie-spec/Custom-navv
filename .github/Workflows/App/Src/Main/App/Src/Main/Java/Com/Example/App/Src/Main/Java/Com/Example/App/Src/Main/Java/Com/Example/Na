package com.example.navapp.ui

import androidx.compose.animation.*
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.graphicsLayer
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import com.example.navapp.models.MasterAppSettings
import com.example.navapp.ui.components.AvatarSelectionDialog

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainNavigationScreen(
    settings: MasterAppSettings,
    onSettingsChanged: (MasterAppSettings) -> Unit
) {
    var showSettingsSheet by remember { mutableStateOf(false) }
    var showAvatarDialog by remember { mutableStateOf(false) }

    val hudScaleX = if (settings.isHudModeEnabled) -1f else 1f
    val hudScaleY = if (settings.isHudModeEnabled) -1f else 1f

    Box(
        modifier = Modifier
            .fillMaxSize()
            .graphicsLayer {
                scaleX = hudScaleX
                scaleY = hudScaleY
            }
            .background(Color(0xFF121212))
    ) {
        Column(
            modifier = Modifier.fillMaxSize(),
            verticalArrangement = Arrangement.Center,
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Text(text = settings.avatarPuck.emoji, fontSize = 72.sp)
            Spacer(modifier = Modifier.height(8.dp))
            Text(text = "Active Avatar: ${settings.avatarPuck.displayName}", color = Color.White, fontSize = 18.sp)
            Text(
                text = "Routing: ${settings.vehicleRestrictions.label} | ${settings.routeOptimization.label}",
                color = Color.Gray,
                fontSize = 14.sp
            )

            Row(
                modifier = Modifier.padding(top = 16.dp),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                if (settings.showLiveTraffic) OverlayBadge("Live Traffic", Color.Green)
                if (settings.showSpeedCameras) OverlayBadge("Speed Cameras", Color.Red)
                if (settings.showWeatherRadar) OverlayBadge("Weather Radar", Color.Cyan)
            }
        }

        Surface(
            modifier = Modifier
                .fillMaxWidth()
                .padding(16.dp),
            shape = RoundedCornerShape(16.dp),
            color = Color(0xDD1E1E1E)
        ) {
            Row(
                modifier = Modifier.padding(16.dp),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Icon(Icons.Default.ArrowForward, contentDescription = null, tint = settings.accentColor, modifier = Modifier.size(36.dp))
                    Spacer(modifier = Modifier.width(12.dp))
                    Column {
                        Text("In 300 meters", color = Color.Gray, fontSize = 12.sp)
                        Text("Turn Right onto High St", color = Color.White, fontSize = 18.sp)
                    }
                }
                Column(horizontalAlignment = Alignment.End) {
                    Text("42", color = settings.accentColor, fontSize = 28.sp)
                    Text("MPH", color = Color.Gray, fontSize = 10.sp)
                }
            }
        }

        if (settings.showMusicWidget) {
            Surface(
                modifier = Modifier
                    .align(Alignment.BottomStart)
                    .padding(start = 16.dp, bottom = 90.dp),
                shape = RoundedCornerShape(12.dp),
                color = Color(0xDD252525)
            ) {
                Row(
                    modifier = Modifier.padding(horizontal = 12.dp, vertical = 8.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Icon(Icons.Default.PlayArrow, contentDescription = null, tint = Color.Green)
                    Spacer(modifier = Modifier.width(8.dp))
                    Text("Spotify: Driver Playlist", color = Color.White, fontSize = 12.sp)
                }
            }
        }

        Column(
            modifier = Modifier
                .align(Alignment.BottomEnd)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            FloatingActionButton(
                onClick = { onSettingsChanged(settings.copy(isHudModeEnabled = !settings.isHudModeEnabled)) },
                containerColor = if (settings.isHudModeEnabled) settings.accentColor else Color.DarkGray,
                shape = CircleShape
            ) {
                Icon(Icons.Default.Refresh, contentDescription = "HUD Mode", tint = Color.White)
            }

            FloatingActionButton(
                onClick = { showAvatarDialog = true },
                containerColor = Color.DarkGray,
                shape = CircleShape
            ) {
                Text(settings.avatarPuck.emoji, fontSize = 20.sp)
            }

            FloatingActionButton(
                onClick = { showSettingsSheet = true },
                containerColor = settings.accentColor,
                shape = CircleShape
            ) {
                Icon(Icons.Default.Settings, contentDescription = "Settings", tint = Color.White)
            }
        }
    }

    if (showAvatarDialog) {
        AvatarSelectionDialog(
            currentSettings = settings,
            onDismiss = { showAvatarDialog = false },
            onAvatarSelected = { updatedSettings ->
                onSettingsChanged(updatedSettings)
                showAvatarDialog = false
            }
        )
    }

    if (showSettingsSheet) {
        ModalBottomSheet(
            onDismissRequest = { showSettingsSheet = false },
            containerColor = Color(0xFF1E1E2C)
        ) {
            SettingsScreen(
                settings = settings,
                onSettingsChanged = onSettingsChanged
            )
        }
    }
}

@Composable
fun OverlayBadge(label: String, color: Color) {
    Surface(
        shape = RoundedCornerShape(8.dp),
        color = color.copy(alpha = 0.2f)
    ) {
        Text(
            text = label,
            color = color,
            fontSize = 10.sp,
            modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp)
        )
    }
}
